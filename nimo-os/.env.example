# Gemini API Key (nimo-os no longer uses this — NIMO backend uses Claude instead)
# GEMINI_API_KEY="MY_GEMINI_API_KEY"

# URL of the NIMO backend HTTP server (Electron app).
# This server must be running for commands to execute.
# Default: http://localhost:3001
NIMO_BACKEND_URL="http://localhost:3001"

# APP_URL: The URL where nimo-os is hosted (for self-referential links / OAuth).
# Default for local dev: http://localhost:3000
APP_URL="http://localhost:3000"